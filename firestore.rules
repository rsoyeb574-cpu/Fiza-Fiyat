rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          request.auth.token.email != null &&
          (
            request.auth.token.email == 'rsoyeb574@gmail.com' ||
            request.auth.token.email == 'admin@fizahayatresearch.com' ||
            request.auth.token.email == 'admin@fiza-hayat-buildcom.iam.gserviceaccount.com'
          )
        )
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default catch-all: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins metadata collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =======================================================
    // 1. PUBLIC CATALOG & READ-ONLY CONTENT COLLECTIONS
    // =======================================================
    match /projects/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /services/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /blogs/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /team/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /media/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{document=**} { allow read: if true; allow write: if isAdmin(); }

    // Construction Database & Catalog
    match /construction_guides/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /construction_presets/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /construction_rates/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /cities/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /states/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /countries/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /materials/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /material_categories/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /labor_rates/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /foundation_types/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /column_types/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /beam_types/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /roof_types/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /slab_types/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /wall_types/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /brick_types/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /block_types/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /door_types/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /window_types/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /house_plans/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /models_3d/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /construction_tips/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /construction_videos/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /project_gallery/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /sliders/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /seo/{document=**} { allow read: if true; allow write: if isAdmin(); }

    // Marketplace Catalogs
    match /digital_products/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /seller_stores/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /courses/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /job_listings/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /professional_directory/{document=**} { allow read: if true; allow write: if isAdmin(); }

    // =======================================================
    // 2. PUBLIC USER SUBMISSIONS & INQUIRIES
    // =======================================================
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /newsletter/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /customer_reviews/{reviewId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    match /job_applications/{appId} {
      allow create: if true;
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.applicantEmail == request.auth.token.email ||
          resource.data.userId == request.auth.uid
        )
      );
      allow update, delete: if isAdmin();
    }

    // =======================================================
    // 3. USER ACCOUNTS & PROFILES
    // =======================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) || 
        request.resource.data.role != 'admin' || 
        isAdmin()
      );
      allow update: if isAdmin() || (
        isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin'])
        )
      );
      allow delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // =======================================================
    // 4. ENTERPRISE FINANCIAL & BUSINESS DATA (STRICT PROTECTED)
    // =======================================================
    match /enterprise_projects/{projectId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.clientUid == request.auth.uid ||
          resource.data.clientEmail == request.auth.token.email
        )
      );
      allow write: if isAdmin();
    }

    match /quotations/{quoteId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.clientUid == request.auth.uid ||
          resource.data.clientEmail == request.auth.token.email
        )
      );
      allow write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.clientUid == request.auth.uid ||
          resource.data.clientEmail == request.auth.token.email
        )
      );
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.clientUid == request.auth.uid ||
          resource.data.clientEmail == request.auth.token.email
        )
      );
      allow write: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /crm_leads/{leadId} {
      allow read, write: if isAdmin();
    }

    match /storage_files/{fileId} {
      allow read, write: if isAdmin();
    }

    match /calendar_events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.assigneeUid == request.auth.uid ||
          resource.data.clientUid == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    // AUDIT LOGS: Read by Admin only; NEVER writable by clients!
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =======================================================
    // 5. INTERACTIVE & USER DATA COLLECTIONS
    // =======================================================
    match /chat_messages/{msgId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid ||
          resource.data.clientUid == request.auth.uid
        )
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.senderId == request.auth.uid);
    }

    match /marketplace_orders/{orderId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.buyerUid == request.auth.uid ||
          resource.data.sellerUid == request.auth.uid
        )
      );
      allow create: if isAuthenticated() && request.resource.data.buyerUid == request.auth.uid;
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.buyerUid == request.auth.uid ||
          resource.data.sellerUid == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);
    }

    match /student_progress/{progressId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.studentUserId == request.auth.uid ||
          progressId.startsWith(request.auth.uid)
        )
      );
      allow write: if isAdmin() || (
        isAuthenticated() && (
          request.resource.data.studentUserId == request.auth.uid ||
          progressId.startsWith(request.auth.uid)
        )
      );
    }

    match /aiGenerations/{generationId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == 'anonymous_guest_user'));
      allow create: if true;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
  }
}
